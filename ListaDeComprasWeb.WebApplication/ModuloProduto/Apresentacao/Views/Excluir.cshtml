@using ListaDeComprasWeb.WebApplication.ModuloProduto.Apresentacao
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão de Produto";
}

@model ExcluirProdutoViewModel;

<div class="alert alert-primary border-start border-primary border-2 rounded-3" role="alert">
    Deseja mesmo excluir este produto?
</div>

<<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Excluir"
       asp-route-id="@Model.Id" method="post">

    <h4 class="text-primary mb-4">Excluir Produto</h4>

    <div class="mb-3">
        <label asp-for="Nome" class="form-label fw-semibold text-primary text-uppercase small">Nome</label>
        <input asp-for="Nome" type="text" class="form-control" disabled>
        <span asp-validation-for="Nome" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Unidade" class="form-label fw-semibold text-primary text-uppercase small">Unidade</label>
        <input asp-for="Unidade" type="text" class="form-control" disabled>
        <span asp-validation-for="Unidade" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Preco" class="form-label fw-semibold text-primary text-uppercase small">Preco</label>
        <input asp-for="Preco" type="text" class="form-control" disabled>
        <span asp-validation-for="Preco" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CategoriaNome"
               class="form-label fw-semibold text-primary text-uppercase small">Categoria</label>
        <input asp-for="CategoriaNome" type="text" class="form-control" disabled>
        <span asp-validation-for="CategoriaNome" class="text-danger small fw-semibold"></span>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
        <button class="btn btn-success rounded-pill px-4" type="submit">Confirmar</button>
    </div>
</form>
