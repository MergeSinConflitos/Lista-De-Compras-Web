@using ListaDeComprasWeb.WebApplication.ModuloProduto.Apresentacao
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Edição de Produto";
}

@model EditarProdutoViewModel;

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Editar"
      asp-route-id="@Model.Id" method="post">

    <h4 class="text-primary mb-4">Editar Produto</h4>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>

    <div class="mb-3">
        <label asp-for="Nome" class="form-label fw-semibold text-primary text-uppercase small">Nome</label>
        <input asp-for="Nome" type="text" class="form-control">
        <span asp-validation-for="Nome" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Unidade" class="form-label fw-semibold text-primary text-uppercase small">Unidade de
            Medida</label>
            <select asp-for="Unidade" class="form-select">
                <option value="">Selecione uma unidade...</option>
                <option value="UN">Unidade</option>
                <option value="KG">Quilograma</option>
                <option value="G">Grama</option>
                <option value="L">Litro</option>
                <option value="ML">Mililitro</option>
                <option value="CX">Caixa</option>
                <option value="PCT">Pacote</option>
            </select>
            <span asp-validation-for="Unidade" class="text-danger small fw-semibold"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Preco" class="form-label fw-semibold text-primary text-uppercase small">Preço</label>
            <div class="input-group">
                <span class="input-group-text">R$</span>
                <input asp-for="Preco" type="number" step="0.01" min="0.01" class="form-control" placeholder="0,00">
            </div>
            <span asp-validation-for="Preco" class="text-danger small fw-semibold"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold text-primary text-uppercase small">Categoria</label>
            <select asp-for="CategoriaId" class="form-select">
                <option value="">Selecione uma categoria...</option>
                @foreach (var cat in Model.Categorias)
                {
                    <option value="@cat.Id">@cat.Nome</option>
                }
            </select>
            <span asp-validation-for="CategoriaId" class="text-danger small fw-semibold"></span>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
            <button class="btn btn-success rounded-pill px-4" type="submit">Confirmar</button>
        </div>
    </form>