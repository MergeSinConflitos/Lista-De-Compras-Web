@using ListaDeComprasWeb.WebApplication.ModuloItemLista.Apresentacao
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastro de Item";
}

@model CadastrarItemListaViewModel;

@if (Model.Produtos.Count == 0)
{
    <div class="alert alert-primary border-start border-primary border-4 rounded-3 mx-auto" style="max-width: 620px;" role="alert">
        Cadastre um produto antes de adicionar itens na lista.
    </div>
}

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Cadastrar" method="post">
    <input asp-for="ListaComprasId" type="hidden">

    <div class="mb-3">
        <label asp-for="ProdutoId" class="form-label fw-semibold text-primary text-uppercase small">Produto</label>
        <select asp-for="ProdutoId" class="form-select">
            <option value="">Selecione um produto</option>
            @foreach (OpcaoProdutoViewModel produto in Model.Produtos)
            {
                <option value="@produto.Id">@produto.Nome - @produto.CategoriaNome (@produto.Preco/@produto.Unidade)</option>
            }
        </select>
        <span asp-validation-for="ProdutoId" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Quantidade" class="form-label fw-semibold text-primary text-uppercase small">Quantidade</label>
        <input asp-for="Quantidade" type="number" min="0.01" step="0.01" class="form-control">
        <span asp-validation-for="Quantidade" class="text-danger small fw-semibold"></span>
    </div>

    <div class="d-flex justify-content-between align-items-center gap-3 mt-4 flex-wrap">
        <div class="form-check">
            <input asp-for="AdicionarOutro" class="form-check-input" type="checkbox">
            <label asp-for="AdicionarOutro" class="form-check-label">Adicionar outro</label>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar" asp-route-listaId="@Model.ListaComprasId">Voltar</a>
            @if (Model.Produtos.Count == 0)
            {
                <button class="btn btn-primary rounded-pill px-4" type="submit" disabled>Confirmar</button>
            }
            else
            {
                <button class="btn btn-primary rounded-pill px-4" type="submit">Confirmar</button>
            }
        </div>
    </div>
</form>