@using ListaDeComprasWeb.WebApplication.ModuloItemLista.Apresentacao
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão de Item";
}

@model ExcluirItemListaViewModel;

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Excluir" asp-route-id="@Model.Id" method="post">
    <input asp-for="Id" type="hidden">
    <input asp-for="ListaComprasId" type="hidden">

    <div class="alert alert-primary border-start border-primary border-4 rounded-3" role="alert">
        Deseja realmente remover este item da lista?
    </div>

    <dl class="row mb-0">
        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">Lista</dt>
        <dd class="col-sm-8">@Model.ListaComprasNome</dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">Produto</dt>
        <dd class="col-sm-8">@Model.ProdutoNome</dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">Categoria</dt>
        <dd class="col-sm-8">@Model.CategoriaNome</dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">Quantidade</dt>
        <dd class="col-sm-8">@Model.Quantidade @Model.Unidade</dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">Subtotal</dt>
        <dd class="col-sm-8">@Model.Subtotal.ToString("C")</dd>
    </dl>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar" asp-route-listaId="@Model.ListaComprasId">Voltar</a>
        <button class="btn btn-primary rounded-pill px-4" type="submit">Confirmar</button>
    </div>
</form>