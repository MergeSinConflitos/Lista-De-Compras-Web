@using ListaDeComprasWeb.WebApplication.ModuloListaDeCompras.Apresentacao
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Adicionar Item";
}

@model AdicionarItemViewModel;

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;"
      asp-controller="ItemListaCompras" asp-action="Adicionar" method="post">

    <h4 class="text-primary mb-4">Adicionar Item à Lista</h4>

    <input type="hidden" asp-for="ListaId" />

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger" role="alert">
            @foreach (var erro in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <p class="mb-0">@erro.ErrorMessage</p>
            }
        </div>
    }

    <div class="mb-3">
        <label asp-for="ProdutoId" class="form-label fw-semibold text-primary text-uppercase small">Produto</label>
        <select asp-for="ProdutoId" class="form-select">
            <option value="">Selecione um produto...</option>
            @foreach (var produto in Model.Produtos!)
            {
                <option value="@produto.Id">@produto.Nome (@produto.Categoria.Nome)</option>
            }
        </select>
        <span asp-validation-for="ProdutoId" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Quantidade" class="form-label fw-semibold text-primary text-uppercase small">Quantidade</label>
        <input asp-for="Quantidade" type="number" min="1" class="form-control">
        <span asp-validation-for="Quantidade" class="text-danger small fw-semibold"></span>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4"
           asp-controller="ListaCompras"
           asp-action="Detalhes"
           asp-route-id="@Model.ListaId">Voltar</a>
        <button class="btn btn-success rounded-pill px-4" type="submit">Adicionar</button>
    </div>
</form>