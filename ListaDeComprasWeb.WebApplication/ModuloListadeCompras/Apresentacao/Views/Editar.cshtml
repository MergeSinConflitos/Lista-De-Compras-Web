@using ListaDeComprasWeb.WebApplication.ModuloListadeCompras.Apresentacao
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Edição de Lista de Compras";
}

@model EditarListaComprasViewModel;

<div class="card shadow-sm max-width-600 mx-auto">
    <div class="card-body">
        <h2 class="h4 text-primary mb-4">Editar Lista</h2>
        
        <form asp-action="Editar" method="post">
            <input type="hidden" asp-for="Id" />
            
            <div class="mb-3">
                <label asp-for="Nome" class="form-label">Nome da Lista</label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Status" class="form-label">Status da Lista</label>
                <select asp-for="Status" class="form-select">
                    <option value="Aberta">Aberta</option> <!-- -->
                    <option value="Concluída">Concluída</option> <!-- -->
                </select>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4">Atualizar</button>
                <a asp-action="Listar" class="btn btn-light">Voltar</a>
            </div>
        </form>
    </div>
</div>