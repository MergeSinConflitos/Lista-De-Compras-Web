@using System.Linq
@using ListaDeComprasWeb.WebApplication.ModuloListaDeCompras.Apresentacao
@using ListaDeComprasWeb.WebApplication.ModuloListaDeCompras.Dominio
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Listas de Compras";
}

@model List<ListarListasDeComprasViewModel>

<a class="btn btn-outline-primary rounded-pill px-4 mb-3" asp-action="Cadastrar">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-lg me-1"
         viewBox="0 0 16 16">
        <path fill-rule="evenodd"
              d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2Z" />
    </svg>
    Cadastrar Nova Lista
</a>

@if (TempData["MensagemErro"] is string mensagemErro)
{
    <div class="alert alert-danger border-start border-danger border-4 rounded-3" role="alert">
        @mensagemErro
    </div>
}

@if (TempData["MensagemSucesso"] is string mensagemSucesso)
{
    <div class="alert alert-success border-start border-success border-4 rounded-3" role="alert">
        @mensagemSucesso
    </div>
}

@if (!Model .Any())

{
    <div class="alert alert-primary border-start border-primary border-2 rounded-3" role="alert">
        Nenhuma lista de compras cadastrada.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (ListarListasDeComprasViewModel lista in Model)
        {  
            var statusCor = lista.Status == StatusListaCompras.Aberta ? "#198754" : "#6c757d";
            var statusTexto = lista.Status == StatusListaCompras.Aberta ? "Aberta" : "Concluída";
            var statusBadge = lista.Status == StatusListaCompras.Aberta ? "bg-success" : "bg-secondary";

            <div class="col">
                <div class="card h-100 shadow-sm border-0" style="transition: all 0.3s ease;">

                    @* barra de status no topo *@
                    <div class="card-header border-0" style="background-color: @statusCor; height: 8px;"></div>

                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">@lista.Nome</h5>
                            <span class="badge @statusBadge rounded-pill">@statusTexto</span>
                        </div>

                        <small class="text-muted">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor"
                                 class="bi bi-calendar me-1" viewBox="0 0 16 16">
                                <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4H1z"/>
                            </svg>
                            @lista.DataCriacao.ToShortDateString()
                        </small>

                        <hr class="my-3" />

                        <div class="d-flex justify-content-between">
                            <div class="text-center">
                                <div class="fw-bold text-primary fs-5">@lista.TotalItens</div>
                                <small class="text-muted">Itens</small>
                            </div>
                            <div class="text-center">
                                <div class="fw-bold text-success fs-5">@lista.TotalGasto.ToString("C2")</div>
                                <small class="text-muted">Total estimado</small>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer bg-transparent border-0 pt-0 pb-3">
                        <div class="d-grid gap-2 d-md-flex">
                            <a class="btn btn-primary btn-sm flex-fill" asp-controller="ItemLista" asp-action="Listar"
                               asp-route-id="@lista.Id">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor"
                                     class="bi bi-list-ul me-1" viewBox="0 0 16 16">
                                    <path fill-rule="evenodd"
                                          d="M5 11.5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5zm-3 1a1 1 0 1 1 0-2 1 1 0 0 1 0 2zm0 4a1 1 0 1 1 0-2 1 1 0 0 1 0 2zm0 4a1 1 0 1 1 0-2 1 1 0 0 1 0 2z" />
                                </svg>
                                Ver Itens
                            </a>
                            <a class="btn btn-outline-primary btn-sm" asp-action="Editar"
                               asp-route-id="@lista.Id">Editar</a>
                            <a class="btn btn-outline-danger btn-sm" asp-action="Excluir"
                               asp-route-id="@lista.Id">Excluir</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
    .card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, .15) !important;
    }
</style>