@using ListaDeComprasWeb.WebApplication.ModuloListadeCompras.Apresentacao
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastro de Lista de Compras";
}

@model CadastrarListaComprasViewModel;


<div class="card shadow-sm max-width-600 mx-auto">
    <div class="card-body">
        <h2 class="h4 text-primary mb-4">Criar Nova Lista</h2>
        
        <form asp-action="Cadastrar" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Nome" class="form-label">Nome da Lista</label>
                <input asp-for="Nome" class="form-control" placeholder="Ex: Compras do Mês" /> <!-- -->
                <span asp-validation-for="Nome" class="text-danger"></span> <!-- -->
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4">Salvar</button>
                <a asp-action="Listar" class="btn btn-light">Cancelar</a>
            </div>
        </form>
    </div>
</div>